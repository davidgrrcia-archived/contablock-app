@startuml
left to right direction
skinparam packageStyle rectangle

actor contable #FFA500
actor auditor #008000
actor usuario #0000FF

rectangle ContaBlock {
  contable --> (crear, modificar y eliminar asientos contables) #FFA500
  contable --> (solicitar revisión de asientos contables) #FFA500
  contable -> (publicar asientos contables) #FFA500
  contable --> (consultar libro diario, libro mayor y balance de situación) #FFA500
  auditor --> (consultar libro diario, libro mayor y balance de situación) #008000
  auditor --> (aprobar asientos contables) #008000
  auditor --> (rechazar asientos contables) #008000
  usuario --> (consultar libro diario, libro mayor y balance de situación) #0000FF

  (crear, modificar y eliminar asientos contables) --> (iniciar sesión) : include
  (solicitar revisión de asientos contables) --> (iniciar sesión) : include
  (aprobar asientos contables) --> (iniciar sesión) : include
  (aprobar asientos contables) --> (solicitar revisión de asientos contables) : include
  (rechazar asientos contables) --> (iniciar sesión) : include
  (rechazar asientos contables) --> (solicitar revisión de asientos contables) : include
  (publicar asientos contables) --> (iniciar sesión) : include
  (publicar asientos contables) --> (aprobar asientos contables) : include
  (consultar libro diario, libro mayor y balance de situación) --> (iniciar sesión) : include
}
@enduml
