@startuml

class Account {
  +Project: string
  +ID: string
  +Name: string
  +Level: string
  +BalanceID: *string
  +DisplayName: string
}

class Balance {
  +Project: string
  +ID: string
  +Type: string
  +Kind: *string
  +Parent: *string
  +Child: *string
  +Accounts: []string
  +CurrentYear: int
  +PreviousYear: int
  +CurrentAmount: float64
  +PreviousAmount: float64
}

class Business {
  +Project: string
  +ID: string
  +Name: string
  +SocialDenomination: string
  +RegisteredOffice: string
  +Cif: string
  +Logo: string
}

class Contract {
  +Project: string
  +ID: string
  +Name: string
  +Description: string
  +EthAddress: string
  +Network: string
  +AdminID: string
  +CreationDate: time.Time
  +LastUpdate: time.Time
}

class Entry {
  +Project: string
  +ID: string
  +ContractID: string
  +UserID: string
  +AccountID: string
  +MultipleEntryID: string
  +BalanceByYearID: *string
  +Currency: string
  +Concept: *string
  +Date: time.Time
  +Quarter: int
  +DebitBalance: float64
  +CreditBalance: float64
  +State: string
  +StateReason: *string
  +CreationDate: time.Time
  +LastUpdate: time.Time
}

class User {
  +Project: string
  +ID: string
  +ContractID: string
  +Name: string
  +Email: string
  +Password: string
  +Role: string
  +EthAddress: string
  +PrivateKey: string
  +DefaultPasswordChanged: bool
  +Network: string
  +BusinessID: string
  +CreationDate: time.Time
  +LastUpdate: time.Time
}

class BalanceByYear {
  +Project: string
  +ID: string
  +BalanceID: string
  +Amount: float64
  +Year: int
}

Balance "1" -- "0..N" BalanceByYear
Balance "1" o-- "0..N" Account
User "1" -- "0..N" Entry 
User "0..N" --> "1" Contract 
User "0..N" --* "1" Business 
Account "1" -- "0..N" Entry 
BalanceByYear "1" -- "0..N" Entry 
Contract "1" -- "0..N" Entry

@enduml
